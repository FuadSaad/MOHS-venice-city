# ==========================================
# MOHS VENICE CITY ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Local SQLite Database (Default)
DATABASE_URL="file:./dev.db"

# 2. Production PostgreSQL Database (Uncomment when deploying to Supabase/Neon/Railway/Vercel)
# In prisma/schema.prisma change provider = "postgresql"
# DATABASE_URL="postgresql://user:password@localhost:5432/mohs_venice_city?schema=public"

# Admin Authentication
JWT_SECRET="replace_with_a_secure_random_secret_in_production"
ADMIN_EMAIL="admin@mohs.com"
ADMIN_PASSWORD="admin123"

# Public Company Information
NEXT_PUBLIC_APP_NAME="MOHS Venice City"
NEXT_PUBLIC_APP_TAGLINE="Your Property Partner | Uttara - Purbachal"
NEXT_PUBLIC_PHONE="+880 1711-000000"
NEXT_PUBLIC_EMAIL="info@mohsvenicecity.com"
NEXT_PUBLIC_ADDRESS="Uttara - Purbachal Link Road, Dhaka, Bangladesh"

# Cloudinary (Optional for direct cloud uploads)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
